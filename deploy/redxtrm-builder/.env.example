# Public service contract
T3_APP_MODE=redxtrm-remote
T3CODE_MODE=web
T3CODE_HOST=0.0.0.0
T3CODE_PORT=3000
T3CODE_HOME=/var/lib/t3code
T3CODE_NO_BROWSER=true
T3CODE_AUTO_BOOTSTRAP_PROJECT_FROM_CWD=false
T3CODE_LOG_WS_EVENTS=false
T3CODE_LOG_LEVEL=Warn
T3CODE_TELEMETRY_ENABLED=false

# Keep Node as the production default. `bun` is supported for compatibility
# testing against the same compiled artifact.
T3_RUNTIME=node

# Dashboard-to-builder handoff verification. Set these in Coolify; never commit
# real values. The ticket secret must be dedicated to this service and at least
# 32 bytes. The origin must exactly match the public HTTPS builder origin.
T3_REDXTRM_BUILDER_ORIGIN=https://builder.redxtrm.com
T3_REDXTRM_BUILDER_TICKET_SECRET=

# Isolated Client Dev BFF. These are server-only values; never prefix them with
# VITE_ or expose them through the browser bundle.
T3_REDXTRM_CLIENT_DEV_ORIGIN=
T3_REDXTRM_CLIENT_DEV_API_KEY=
T3_REDXTRM_CLIENT_DEV_AGENT_KEY=

# Optional bounded Client Dev BFF controls.
T3_REDXTRM_CLIENT_DEV_TIMEOUT_MS=30000
T3_REDXTRM_CLIENT_DEV_MAX_RESPONSE_BYTES=1048576

# Optional observability endpoints. Keep credentials in server-only Coolify
# values and use an authenticated collector rather than a browser endpoint.
T3CODE_OTLP_TRACES_URL=
T3CODE_OTLP_METRICS_URL=
T3CODE_OTLP_SERVICE_NAME=redxtrm-builder
